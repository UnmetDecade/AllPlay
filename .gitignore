# ============================================================================
# Build artifacts
# ============================================================================
/build/
build-*/
cmake-build-*/
compile_commands.json
.cache/
*.o
*.a

# ============================================================================
# Sensitive files — never commit
# ============================================================================
# MFi accessory identity: Apple-issued credentials (private key + certificate). These are sensitive,
# so do not copy them elsewhere or add them to any repository. At runtime they live in identity/ (see "Repository layout" in the README).
/identity/
*.pk8
*.p7b
*.p12
*.key
*.pem
*.der
*.cer
*.crt
*.mobileprovision

# Android signing keys
*.jks
*.keystore

# Scratch directory: dumped firmware / extracted credentials / packet captures tend to land here.
# Do not count on it being safe — the only safe place is not putting things here at all.
/tmp/

# ============================================================================
# OS / editor
# ============================================================================
.DS_Store
.idea/
.vscode/
*.swp
*~

# ============================================================================
# Android (Gradle / NDK generated)
# ============================================================================
/android/.gradle/
/android/**/build/
/android/local.properties
/android/**/.cxx/
/android/.idea/
*.iml
*.apk
*.aab

# ============================================================================
# Logs
# ============================================================================
*.log
